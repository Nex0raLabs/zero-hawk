# Copy this file to .env and add your own provider settings.
# ollama, claude-code, codex, openai-compatible, or anthropic
OPENPROSPECT_AI_PROVIDER=ollama
OPENPROSPECT_AI_MODEL=llama3.2
OPENPROSPECT_AI_API_KEY=
OPENPROSPECT_AI_BASE_URL=http://localhost:11434/v1
OPENPROSPECT_HOST=127.0.0.1
OPENPROSPECT_PORT=5555
# Optional: set a custom data directory
# OPENPROSPECT_HOME=C:/Users/YourName/.openprospect

# Optional SMTP sending (STARTTLS, normally port 587). Never commit real credentials.
OPENPROSPECT_SMTP_HOST=
OPENPROSPECT_SMTP_PORT=587
OPENPROSPECT_SMTP_USER=
OPENPROSPECT_SMTP_PASSWORD=
OPENPROSPECT_FROM_EMAIL=
OPENPROSPECT_DAILY_SEND_LIMIT=25
# Must be your public HTTPS base URL for the one-click unsubscribe endpoint.
OPENPROSPECT_PUBLIC_BASE_URL=

# Optional IMAP inbox sync (SSL, normally port 993).
OPENPROSPECT_IMAP_HOST=
OPENPROSPECT_IMAP_PORT=993
OPENPROSPECT_IMAP_USER=
OPENPROSPECT_IMAP_PASSWORD=
OPENPROSPECT_IMAP_FOLDER=INBOX

# Optional WhatsApp sidecar. Use a long random shared secret in BOTH environments.
WA_SIDECAR_URL=http://127.0.0.1:8787
WA_SIDECAR_TOKEN=
