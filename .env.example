# Copy this file to .env and add your own provider settings.
# ollama, claude-code, codex, openai-compatible, or anthropic
ZERO_HAWK_AI_PROVIDER=ollama
ZERO_HAWK_AI_MODEL=llama3.2
ZERO_HAWK_AI_API_KEY=
ZERO_HAWK_AI_BASE_URL=http://localhost:11434/v1
ZERO_HAWK_HOST=127.0.0.1
ZERO_HAWK_PORT=5555
# Optional: set a custom data directory
ZERO_HAWK_HOME=C:/Users/YourName/.zero-hawk

# Optional SMTP sending (STARTTLS, normally port 587). Never commit real credentials.
ZERO_HAWK_SMTP_HOST=
ZERO_HAWK_SMTP_PORT=587
ZERO_HAWK_SMTP_USER=
ZERO_HAWK_SMTP_PASSWORD=
ZERO_HAWK_FROM_EMAIL=
ZERO_HAWK_DAILY_SEND_LIMIT=25
# Must be your public HTTPS base URL for the one-click unsubscribe endpoint.
ZERO_HAWK_PUBLIC_BASE_URL=

# Optional IMAP inbox sync (SSL, normally port 993).
ZERO_HAWK_IMAP_HOST=
ZERO_HAWK_IMAP_PORT=993
ZERO_HAWK_IMAP_USER=
ZERO_HAWK_IMAP_PASSWORD=
ZERO_HAWK_IMAP_FOLDER=INBOX

# Optional WhatsApp sidecar. Use a long random shared secret in BOTH environments.
WA_SIDECAR_URL=http://127.0.0.1:8787
WA_SIDECAR_TOKEN=
